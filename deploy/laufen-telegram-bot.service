[Unit]
Description=Laufen Hub - Bidirectional Telegram Coach Bot & Daily Briefing Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dockerContainer/laufen
EnvironmentFile=-%h/dockerContainer/laufen/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/dockerContainer/laufen/run bot --scheduler
Restart=always
RestartSec=10

[Install]
WantedBy=default.target

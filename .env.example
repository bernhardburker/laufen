# Garmin Connect Credentials
GARMIN_EMAIL=YOUR_GARMIN_EMAIL_HERE
GARMIN_PASSWORD=YOUR_GARMIN_PASSWORD_HERE

# Intervals.icu API
# Hinweis: Falls INTERVALS_API_KEY bereits global via Environment (z. B. via `pass`) gesetzt ist,
# hat die Shell-Variable Vorrang vor dem Wert in der .env-Datei.
INTERVALS_API_KEY=YOUR_INTERVALS_API_KEY_HERE
INTERVALS_ATHLETE_ID=0  # or your athlete id (e.g. i12345 or 0 for self)

# Strava API (OAuth2)
STRAVA_CLIENT_ID=YOUR_STRAVA_CLIENT_ID_HERE
STRAVA_CLIENT_SECRET=YOUR_STRAVA_CLIENT_SECRET_HERE
STRAVA_REFRESH_TOKEN=YOUR_STRAVA_REFRESH_TOKEN_HERE
